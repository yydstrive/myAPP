{
  "bsonType": "object",
  "required": ["title", "task_date", "completed", "deleted", "created_at", "updated_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": {
      "description": "任务ID"
    },
    "title": {
      "bsonType": "string",
      "title": "任务内容",
      "trim": "both",
      "minLength": 1,
      "maxLength": 120
    },
    "task_date": {
      "bsonType": "string",
      "title": "任务日期",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "priority": {
      "bsonType": "string",
      "title": "任务优先级",
      "enum": ["low", "medium", "high"],
      "defaultValue": "medium"
    },
    "completed": {
      "bsonType": "bool",
      "title": "是否完成",
      "defaultValue": false
    },
    "completed_at": {
      "bsonType": "long",
      "title": "完成时间戳"
    },
    "deleted": {
      "bsonType": "bool",
      "title": "是否在回收站",
      "defaultValue": false
    },
    "deleted_at": {
      "bsonType": "long",
      "title": "移入回收站时间戳"
    },
    "created_at": {
      "bsonType": "long",
      "title": "创建时间戳"
    },
    "updated_at": {
      "bsonType": "long",
      "title": "更新时间戳"
    }
  }
}
